{
  "name": "digital-polthel-pahana",
  "version": "1.0.1",
  "private": true,
  "description": "Realtime virtual oil-lamp lighting ceremony for Raawa 26",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js",
    "build:windows": "pkg . --targets node18-win-x64 --output release/Digital-Polthel-Pahana.exe --compress GZip"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "6.6.0",
    "socket.io-client": "^4.8.4"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "outputPath": "release"
  }
}
